{
  "name": "pi-extensions",
  "version": "2.7.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test $(find . -path ./node_modules -prune -o -name '*.test.ts' -print)",
    "check": "pnpm format:check && pnpm test"
  },
  "pi": {
    "extensions": [
      "./git-workflow/index.ts",
      "./handoff/index.ts",
      "./interview/index.ts",
      "./nodoz/index.ts",
      "./secrets/index.ts",
      "./system-theme/index.ts",
      "./usage/index.ts",
      "./vim/index.ts",
      "./web-search/index.ts",
      "./agency/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16"
  }
}
